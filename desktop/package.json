{
  "name": "afriflow-desktop",
  "version": "0.2.1",
  "description": "AfriFloW Desktop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.7.0"
  },
  "build": {
    "appId": "africa.afriflow.desktop",
    "productName": "AfriFloW",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "AfriFloW-Windows-Setup.exe",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ATAYI-jo",
        "repo": "AfriFlow-Feuille-de-Route",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "AfriFloW message",
        "schemes": [
          "afriflow"
        ]
      }
    ]
  }
}
